#!/bin/bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: goal-runner-pi [PI_OPTIONS...] -- PROMPT_PATH

Run Pi as an isolated one-shot goal agent and emit a compact JSON event stream.
Model, thinking level, and tools remain explicit caller policy.

example:
  goal-runner-pi \
    --thinking high \
    --tools write \
    -- prompt.md

Environment:
  PI_BIN  Pi executable to invoke (default: pi)
EOF
}

pi_command=("${PI_BIN:-pi}")
while (($#)); do
  case $1 in
    --)
      shift
      break
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      pi_command+=("$1")
      shift
      ;;
  esac
done

if (($# != 1)); then
  usage
  exit 2
fi

prompt_path=$1
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if [[ ! -r $prompt_path ]]; then
  echo "goal-runner-pi: prompt is not readable: $prompt_path" >&2
  exit 2
fi

if ! command -v "${pi_command[0]}" >/dev/null 2>&1; then
  echo "goal-runner-pi: Pi executable not found: ${pi_command[0]}" >&2
  exit 127
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "goal-runner-pi: jq is required" >&2
  exit 127
fi

if [[ ${GOAL_RUN_ID:-} == *-worker ]]; then
  if [[ -z ${GOAL_WORK_DIR:-} || ! -d $GOAL_WORK_DIR ]]; then
    echo "goal-runner-pi: worker GOAL_WORK_DIR is unavailable" >&2
    exit 2
  fi
  pr_tools="$PWD/pr_tools.py"
  if [[ ! -r $pr_tools ]]; then
    echo "goal-runner-pi: PR helper is not readable: $pr_tools" >&2
    exit 2
  fi
  real_git=$(command -v git || true)
  if [[ -z $real_git ]]; then
    echo "goal-runner-pi: git is required" >&2
    exit 127
  fi
  guard_bin="$GOAL_WORK_DIR/goal-guard-bin"
  mkdir -p "$guard_bin"
  cat >"$guard_bin/git" <<'SH'
#!/bin/bash
for argument in "$@"; do
  if [[ $argument == push ]]; then
    echo "goal-runner-pi: raw git push is blocked; use GOAL_PR_TOOLS guarded-push" >&2
    exit 2
  fi
done
exec "$GOAL_REAL_GIT" "$@"
SH
  chmod 700 "$guard_bin/git"
  export GOAL_REAL_GIT=$real_git
  export GOAL_PR_TOOLS=$pr_tools
  export PATH="$guard_bin:$PATH"
fi

"${pi_command[@]}" \
  --mode json \
  --no-session \
  --no-context-files \
  --no-extensions \
  --no-skills \
  --no-prompt-templates \
  "@$prompt_path" |
  jq --compact-output --unbuffered \
    --from-file "$script_dir/goal-runner-filter.jq"
